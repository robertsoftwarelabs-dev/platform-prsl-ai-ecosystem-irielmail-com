{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.robertsoftwarelabs.com/prsl-ai/ims/1.0.0/manifest.schema.json",
  "title": "iRiel Manifest Specification",
  "description": "Root catalog manifest for the PRSL-AI ecosystem. Declarations do not grant execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "catalogId",
    "name",
    "owner",
    "generatedAt",
    "capabilities",
    "intents",
    "skills",
    "agents",
    "providers",
    "policies"
  ],
  "properties": {
    "manifestVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "capabilities": {
      "$ref": "#/$defs/definitionReferenceList"
    },
    "intents": {
      "$ref": "#/$defs/definitionReferenceList"
    },
    "skills": {
      "$ref": "#/$defs/definitionReferenceList"
    },
    "agents": {
      "$ref": "#/$defs/definitionReferenceList"
    },
    "providers": {
      "$ref": "#/$defs/definitionReferenceList"
    },
    "policies": {
      "$ref": "#/$defs/definitionReferenceList"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean"
        ]
      }
    }
  },
  "$defs": {
    "definitionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "digest"
          ]
        }
      ]
    },
    "definitionReferenceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definitionReference"
      },
      "uniqueItems": true
    }
  }
}
