# Supabase project configuration
# Publishable values may be exposed to the browser; never place service-role credentials here.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Configure in the deployment environment or a local ignored .env file.
SUPABASE_SERVICE_ROLE_KEY=
