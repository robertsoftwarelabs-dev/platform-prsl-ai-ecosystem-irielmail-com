{
  "$schema": "../../schemas/capability-manifest.schema.json",
  "capability_id": "prsl.agent.vision.analyze-image",
  "name": "Analyze Image",
  "description": "Analyze an image explicitly supplied or authorized by the user and return a structured visual interpretation.",
  "module_id": "prsl.agent.vision",
  "contract_version": "1.0",
  "capability_version": "1.0",
  "lifecycle_status": "specified",
  "owner": "Robert Software Labs",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "media_ref",
      "analysis_mode"
    ],
    "properties": {
      "media_ref": {
        "type": "string",
        "minLength": 1,
        "description": "Reference to an authorized image resource; raw media transport is defined by the runtime."
      },
      "analysis_mode": {
        "enum": [
          "describe",
          "extract_text",
          "inspect_scene"
        ]
      },
      "language": {
        "type": "string",
        "default": "en-US"
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "summary",
      "limitations"
    ],
    "properties": {
      "summary": {
        "type": "string"
      },
      "observations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "permissions": [
    "media.read"
  ],
  "dependencies": {
    "runtime": [
      {
        "id": "prsl-agent-runtime",
        "required": true,
        "version": ">=1.0.0"
      }
    ],
    "framework": [],
    "model": {
      "required": false,
      "provider_constraints": []
    },
    "device": [],
    "service": [],
    "capability": [],
    "permission": [
      {
        "id": "media.read",
        "required": true
      }
    ]
  },
  "availability": {
    "evaluation": "runtime",
    "states": [
      "available",
      "unavailable",
      "permission_required",
      "dependency_missing",
      "degraded_with_fallback"
    ],
    "notes": "Actual availability depends on authorized media access, compatible execution resources, and policy."
  },
  "execution_policy": {
    "execution_modes": [
      "on_device",
      "remote"
    ],
    "routing_policy": "prsl_intelligence_router",
    "privacy_policy": "minimum_disclosure",
    "consent_policy": "explicit_when_required",
    "authority_level": "user_authorized",
    "data_retention": "ephemeral_by_default",
    "fallback_policy": "approved_alternative_only",
    "confirmation_required": false,
    "timeout_ms": 30000,
    "idempotency": "idempotent"
  },
  "tags": [
    "vision",
    "image",
    "multimodal"
  ]
}
