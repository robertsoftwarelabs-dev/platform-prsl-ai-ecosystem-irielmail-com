{
  "$schema": "../../schemas/capability-manifest.schema.json",
  "capability_id": "prsl.agent.recognizers.classify-content",
  "name": "Classify Content",
  "description": "Classify user-authorized content against a declared recognition task and return structured labels with uncertainty and limitations.",
  "module_id": "prsl.agent.recognizers",
  "contract_version": "1.0",
  "capability_version": "1.0",
  "lifecycle_status": "specified",
  "owner": "Robert Software Labs",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "content_ref",
      "recognition_task"
    ],
    "properties": {
      "content_ref": {
        "type": "string",
        "minLength": 1
      },
      "recognition_task": {
        "enum": [
          "object",
          "document_type",
          "scene",
          "pattern",
          "general"
        ]
      },
      "language": {
        "type": "string"
      },
      "max_results": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "items",
      "limitations"
    ],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "attributes": {
              "type": "object"
            }
          }
        }
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "permissions": [
    "media.read"
  ],
  "dependencies": {
    "runtime": [
      {
        "id": "prsl-agent-runtime",
        "required": true,
        "version": ">=1.0.0"
      }
    ],
    "framework": [],
    "model": {
      "required": false,
      "provider_constraints": []
    },
    "device": [],
    "service": [],
    "capability": [],
    "permission": [
      {
        "id": "media.read",
        "required": true
      }
    ]
  },
  "availability": {
    "evaluation": "runtime",
    "states": [
      "available",
      "unavailable",
      "permission_required",
      "dependency_missing",
      "degraded_with_fallback"
    ],
    "notes": "Availability is evaluated at runtime from authorization, compatible resources, dependency health, and PRSL-AI policy. No runtime availability is asserted by this specification."
  },
  "execution_policy": {
    "execution_modes": [
      "on_device",
      "remote"
    ],
    "routing_policy": "prsl_intelligence_router",
    "privacy_policy": "minimum_disclosure",
    "consent_policy": "explicit_when_required",
    "authority_level": "user_authorized",
    "data_retention": "ephemeral_by_default",
    "fallback_policy": "approved_alternative_only",
    "confirmation_required": false,
    "timeout_ms": 30000,
    "idempotency": "operation_defined"
  },
  "tags": [
    "recognition",
    "classification",
    "multimodal"
  ]
}
