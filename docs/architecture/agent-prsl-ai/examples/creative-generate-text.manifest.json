{
  "$schema": "../../schemas/capability-manifest.schema.json",
  "capability_id": "prsl.agent.creative.generate-text",
  "name": "Generate Text",
  "description": "Generate a user-requested text artifact from a brief while respecting declared format, language, style, and content constraints.",
  "module_id": "prsl.agent.creative",
  "contract_version": "1.0",
  "capability_version": "1.0",
  "lifecycle_status": "specified",
  "owner": "Robert Software Labs",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "brief"
    ],
    "properties": {
      "brief": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "language": {
        "type": "string"
      },
      "format": {
        "enum": [
          "plain_text",
          "markdown",
          "structured_outline"
        ]
      },
      "style": {
        "type": "string"
      },
      "constraints": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "reference_text": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "content",
      "format",
      "limitations"
    ],
    "properties": {
      "content": {
        "type": "string"
      },
      "format": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "provenance": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "permissions": [],
  "dependencies": {
    "runtime": [
      {
        "id": "prsl-agent-runtime",
        "required": true,
        "version": ">=1.0.0"
      }
    ],
    "framework": [],
    "model": {
      "required": false,
      "provider_constraints": []
    },
    "device": [],
    "service": [],
    "capability": [],
    "permission": []
  },
  "availability": {
    "evaluation": "runtime",
    "states": [
      "available",
      "unavailable",
      "permission_required",
      "dependency_missing",
      "degraded_with_fallback"
    ],
    "notes": "Availability is evaluated at runtime from authorization, compatible resources, dependency health, and PRSL-AI policy. No runtime availability is asserted by this specification."
  },
  "execution_policy": {
    "execution_modes": [
      "on_device",
      "remote",
      "hybrid"
    ],
    "routing_policy": "prsl_intelligence_router",
    "privacy_policy": "minimum_disclosure",
    "consent_policy": "explicit_when_required",
    "authority_level": "user_authorized",
    "data_retention": "ephemeral_by_default",
    "fallback_policy": "approved_alternative_only",
    "confirmation_required": false,
    "timeout_ms": 30000,
    "idempotency": "operation_defined"
  },
  "tags": [
    "creative",
    "generation",
    "text"
  ]
}
