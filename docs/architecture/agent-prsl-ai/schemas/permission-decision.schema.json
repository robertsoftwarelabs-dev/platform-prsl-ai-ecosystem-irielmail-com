{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prsl.ai/schemas/permission-decision.schema.json",
  "title": "PRSL-AI Permission Decision",
  "description": "A scoped authorization outcome. A granted decision is not itself an operating-system grant or a transferable bearer credential.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "request_id",
    "status",
    "subject",
    "capability_id",
    "permission_id",
    "purpose",
    "policy_version",
    "issued_at",
    "reason_code"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "granted",
        "denied",
        "consent_required",
        "platform_permission_required",
        "policy_blocked",
        "revoked",
        "indeterminate"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_type",
        "principal_id"
      ],
      "properties": {
        "principal_type": {
          "enum": [
            "user",
            "system"
          ]
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        }
      }
    },
    "capability_id": {
      "type": "string",
      "pattern": "^prsl\\.(agent|integration)\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
    },
    "permission_id": {
      "enum": [
        "media.read",
        "camera.use",
        "microphone.use",
        "location.coarse",
        "location.precise",
        "files.read",
        "files.write",
        "notifications.schedule",
        "network.access",
        "data.remote_disclose",
        "data.retain",
        "tools.execute",
        "system.invoke",
        "accessibility.read",
        "speech.output"
      ]
    },
    "approved_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "scope_mode"
      ],
      "properties": {
        "resource_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "scope_mode": {
          "enum": [
            "exact",
            "bounded"
          ]
        },
        "resource_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "boundary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "precision": {
          "enum": [
            "coarse",
            "precise",
            "not_applicable"
          ]
        },
        "recipient": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact remote provider or service authorized to receive the data."
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration_seconds",
            "storage_scope"
          ],
          "properties": {
            "duration_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000
            },
            "storage_scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "deletion_trigger": {
              "enum": [
                "expiry",
                "user_revocation",
                "operation_completion"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope_mode": {
                "const": "exact"
              }
            }
          },
          "then": {
            "required": [
              "resource_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scope_mode": {
                "const": "bounded"
              }
            }
          },
          "then": {
            "required": [
              "boundary"
            ]
          }
        }
      ]
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose_id",
        "description"
      ],
      "properties": {
        "purpose_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "execution_mode": {
      "enum": [
        "on_device",
        "remote",
        "hybrid"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "single_use": {
      "type": "boolean"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,79}$"
    },
    "explanation": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "granted"
          }
        }
      },
      "then": {
        "required": [
          "approved_scope",
          "execution_mode",
          "expires_at",
          "single_use"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "denied",
              "consent_required",
              "platform_permission_required",
              "policy_blocked",
              "revoked",
              "indeterminate"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "approved_scope"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "permission_id": {
            "const": "data.remote_disclose"
          }
        }
      },
      "then": {
        "properties": {
          "approved_scope": {
            "required": [
              "recipient"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "permission_id": {
            "const": "data.retain"
          }
        }
      },
      "then": {
        "properties": {
          "approved_scope": {
            "required": [
              "retention"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "permission_id": {
            "const": "data.remote_disclose"
          }
        }
      },
      "then": {
        "properties": {
          "execution_mode": {
            "enum": [
              "remote",
              "hybrid"
            ]
          },
          "approved_scope": {
            "required": [
              "recipient"
            ]
          }
        },
        "required": [
          "execution_mode"
        ]
      }
    }
  ]
}
