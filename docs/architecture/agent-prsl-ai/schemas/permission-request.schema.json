{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prsl.ai/schemas/permission-request.schema.json",
  "title": "PRSL-AI Permission Request",
  "description": "A single-operation authorization request evaluated by the Permission Manager.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "subject",
    "capability_id",
    "permission_id",
    "action",
    "resource_scope",
    "purpose",
    "data_classification",
    "execution_mode",
    "requested_duration"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_type",
        "principal_id"
      ],
      "properties": {
        "principal_type": {
          "enum": [
            "user",
            "system"
          ]
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        }
      }
    },
    "capability_id": {
      "type": "string",
      "pattern": "^prsl\\.(agent|integration)\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
    },
    "permission_id": {
      "enum": [
        "media.read",
        "camera.use",
        "microphone.use",
        "location.coarse",
        "location.precise",
        "files.read",
        "files.write",
        "notifications.schedule",
        "network.access",
        "data.remote_disclose",
        "data.retain",
        "tools.execute",
        "system.invoke",
        "accessibility.read",
        "speech.output"
      ]
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "resource_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "scope_mode"
      ],
      "properties": {
        "resource_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "scope_mode": {
          "enum": [
            "exact",
            "bounded"
          ]
        },
        "resource_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "boundary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "precision": {
          "enum": [
            "coarse",
            "precise",
            "not_applicable"
          ]
        },
        "recipient": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact remote provider or service authorized to receive the data."
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration_seconds",
            "storage_scope"
          ],
          "properties": {
            "duration_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000
            },
            "storage_scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "deletion_trigger": {
              "enum": [
                "expiry",
                "user_revocation",
                "operation_completion"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope_mode": {
                "const": "exact"
              }
            }
          },
          "then": {
            "required": [
              "resource_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scope_mode": {
                "const": "bounded"
              }
            }
          },
          "then": {
            "required": [
              "boundary"
            ]
          }
        }
      ]
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose_id",
        "description"
      ],
      "properties": {
        "purpose_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "restricted"
      ]
    },
    "execution_mode": {
      "enum": [
        "on_device",
        "remote",
        "hybrid"
      ]
    },
    "requested_duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "single_operation",
            "seconds"
          ]
        },
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "seconds"
              }
            }
          },
          "then": {
            "required": [
              "seconds"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "single_operation"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "seconds"
              ]
            }
          }
        }
      ]
    },
    "context_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "permission_id": {
            "const": "data.remote_disclose"
          }
        }
      },
      "then": {
        "properties": {
          "resource_scope": {
            "required": [
              "recipient"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "permission_id": {
            "const": "data.retain"
          }
        }
      },
      "then": {
        "properties": {
          "resource_scope": {
            "required": [
              "retention"
            ]
          }
        }
      }
    }
  ]
}
